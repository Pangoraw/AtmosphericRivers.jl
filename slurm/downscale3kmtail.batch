#!/bin/bash
#SBATCH --job-name=ar-3kmtail
#SBATCH --partition=gpua100largex4
#SBATCH --gpus=1
#SBATCH --cpus-per-task=6
#SBATCH --mem=200G
#SBATCH --time=24:00:00
#SBATCH --output=slurm/%x-%j.log

# Tail completion for the 3 km landfall run (original NaN'd at t = 51.3 h in peak
# second-pulse convection). A Dec 9 06Z start NaN'd within minutes — initializing
# into the AR at full strength shocks the acoustic solver — so restart from the
# inter-pulse lull (Dec 8 18Z) with the wizard capped at 5 s, through Dec 10 12Z.
cd "$SLURM_SUBMIT_DIR"

export JULIA_NUM_PRECOMPILE_TASKS=${SLURM_CPUS_PER_TASK:-8}
export OPENBLAS_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8}
export HDF5_USE_FILE_LOCKING=FALSE   # NFS: HDF5 POSIX locks misbehave
export AR_NAME=pnw3kmtail AR_DOMAIN=landfall AR_CELLS_PER_DEGREE=36
export AR_START=2025-12-08T18:00:00 AR_HOURS=42 AR_MAX_DT=5
export AR_RELAX_WIDTH=32 AR_BLEND_LENGTH=240000 AR_TERRAIN_SMOOTHING=4

~/.juliaup/bin/julia --startup-file=no --project=. downscale.jl
