#!/bin/bash
#SBATCH --job-name=ar-6km2
#SBATCH --partition=gpua100largex4
#SBATCH --gpus=2
#SBATCH --ntasks=2
#SBATCH --cpus-per-task=2
#SBATCH --mem=126G
#SBATCH --time=24:00:00
#SBATCH --output=slurm/%x-%j.log

# 6 km corridor (1080x630x50, ~34M cells) on 2 A100s via NCCLDistributed.
# Relaxation width 16 cells = 96 km, matching the validated 12 km configuration.
cd "$SLURM_SUBMIT_DIR"

export JULIA_NUM_PRECOMPILE_TASKS=${SLURM_CPUS_PER_TASK:-8}
export OPENBLAS_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8}
export HDF5_USE_FILE_LOCKING=FALSE   # NFS: HDF5 POSIX locks misbehave
export AR_RANKS=2 AR_NAME=pnw6km AR_CELLS_PER_DEGREE=18 AR_HOURS=72
export AR_RELAX_WIDTH=16 AR_BLEND_LENGTH=240000 AR_LAT_NORTH=57.5 AR_TERRAIN_SMOOTHING=4

# Precompile serially BEFORE mpiexec (ranks race depot pidfiles otherwise).
~/.juliaup/bin/julia --startup-file=no --project=. -e 'using Pkg; Pkg.precompile()'
~/.juliaup/bin/julia --startup-file=no --project=. -e 'using MPI; run(`$(MPI.mpiexec()) -n 2 stdbuf -oL -eL $(Base.julia_cmd()[1]) --startup-file=no --project=. downscale.jl`)'
