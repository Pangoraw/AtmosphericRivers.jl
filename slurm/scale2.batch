#!/bin/bash
#SBATCH --job-name=ar-scale2
#SBATCH --partition=gpua100largex4
#SBATCH --gpus=2
#SBATCH --ntasks=2
#SBATCH --cpus-per-task=2
#SBATCH --mem=120G
#SBATCH --time=03:00:00
#SBATCH --output=slurm/%x-%j.log

# 2-GPU scaling experiment: longitude-partitioned MPI ranks, no output writers.
cd "$SLURM_SUBMIT_DIR"

# Size Julia's workers to the allocation, not the node (24 cores): precompile
# workers and BLAS threads otherwise oversubscribe the cgroup and thrash.
export JULIA_NUM_PRECOMPILE_TASKS=${SLURM_CPUS_PER_TASK:-8}
export OPENBLAS_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8}

export AR_RANKS=2 AR_HOURS=6 AR_NAME=scale2

# Precompile serially BEFORE mpiexec: ranks precompiling concurrently race the
# shared depot's pidfiles (duplicated work, long silent stalls).
~/.juliaup/bin/julia --startup-file=no --project=. -e 'using Pkg; Pkg.precompile()'
~/.juliaup/bin/julia --startup-file=no --project=. -e 'using MPI; run(`$(MPI.mpiexec()) -n 2 $(Base.julia_cmd()[1]) --startup-file=no --project=. downscale.jl`)'
