#!/bin/bash
#SBATCH --job-name=ar-downscale
#SBATCH --partition=gpua100largex4
#SBATCH --gpus=1
#SBATCH --cpus-per-task=6
#SBATCH --mem=120G
#SBATCH --time=24:00:00
#SBATCH --output=slurm/%x-%j.log

# Smoke test first: sbatch --export=ALL,AR_SMOKE=1 slurm/downscale.batch
cd "$SLURM_SUBMIT_DIR"

# Size Julia's workers to the allocation, not the node (24 cores): precompile
# workers and BLAS threads otherwise oversubscribe the cgroup and thrash.
export JULIA_NUM_PRECOMPILE_TASKS=${SLURM_CPUS_PER_TASK:-8}
export OPENBLAS_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8}
export HDF5_USE_FILE_LOCKING=FALSE   # NFS: HDF5 POSIX locks misbehave

# Use the prebuilt system image only when it matches the current Manifest
# (a stale sysimage silently pins old package versions).
SYS=/home/greg_aeolus_earth/AtmosphericRivers.jl/sysimage_a100.so
JFLAGS=""
if [ -f "$SYS" ] && [ -f "$SYS.manifest.sha" ] && [ "$(cat Manifest.toml LocalPreferences.toml 2>/dev/null | sha256sum | cut -d" " -f1)" = "$(cat $SYS.manifest.sha)" ]; then
    JFLAGS="-J $SYS"
fi
~/.juliaup/bin/julia $JFLAGS --startup-file=no --project=. downscale.jl
