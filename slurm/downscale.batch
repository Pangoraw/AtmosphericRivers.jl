#!/bin/bash
#SBATCH --job-name=ar-downscale
#SBATCH --partition=gpua100largex4
#SBATCH --gpus=1
#SBATCH --cpus-per-task=6
#SBATCH --mem=120G
#SBATCH --time=24:00:00
#SBATCH --output=slurm/%x-%j.log

# Smoke test first: sbatch --export=ALL,AR_SMOKE=1 slurm/downscale.batch
cd "$SLURM_SUBMIT_DIR"

# Use the prebuilt system image only when it matches the current Manifest
# (a stale sysimage silently pins old package versions).
SYS=/home/greg_aeolus_earth/AtmosphericRivers.jl/sysimage_a100.so
JFLAGS=""
if [ -f "$SYS" ] && [ -f "$SYS.manifest.sha" ] && [ "$(sha256sum Manifest.toml | cut -d" " -f1)" = "$(cat $SYS.manifest.sha)" ]; then
    JFLAGS="-J $SYS"
fi
~/.juliaup/bin/julia $JFLAGS --startup-file=no --project=. downscale.jl
