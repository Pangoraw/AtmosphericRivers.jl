#!/bin/bash
#SBATCH --job-name=ar-instantiate
#SBATCH --partition=gpua100largex4
#SBATCH --gpus=1
#SBATCH --cpus-per-task=6
#SBATCH --mem=48G
#SBATCH --time=02:00:00
#SBATCH --output=slurm/%x-%j.log

# Instantiate on an A100 node: ~/.julia is NFS-shared and precompile caches are
# arch-specific, so a login-node instantiate does not validate what compute nodes load.
cd "$SLURM_SUBMIT_DIR"
~/.juliaup/bin/julia --startup-file=no --project=. -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'
~/.juliaup/bin/julia --startup-file=no --project=. -e 'using NumericalEarth, Breeze, CUDA; @info "Stack loads" CUDA.functional()'
